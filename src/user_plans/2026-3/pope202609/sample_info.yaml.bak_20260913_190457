defaults:
  inner_motor: huber.x
  outer_motor: huber.y
  inner_range: 0.005
  outer_range: 0.00
  inner_pts: 350
  outer_pts: 1

samples:

  # ------------------------------------------------------------------------
  # sample_1 -- 30 GPa SPATIAL MAP (2026-09-13 evening)
  # ------------------------------------------------------------------------
  # 21 x 21, 5 um step, on the spot where sample is actually seen at 30 GPa.
  #
  #   centre   huber.x -0.2164, huber.y 21.3200   <- where sample was found after
  #                                                  the squeeze (user, 2026-09-13)
  #   span     +-0.05 mm each axis -> x -0.2664..-0.1664, y 21.2700..21.3700
  #   step     0.1 / 20 = 0.005 mm = 5 um, identical to the G0222 map
  #
  # This lands within 0.4 um of the G0222 map centre (-0.216, 21.32), i.e. well
  # inside one motor step, so the 30 GPa map overlays the 11 GPa one essentially
  # point for point. That is what makes a before/after comparison meaningful.
  #
  # NOT the attenuation-ladder spot (-0.2010, 21.3250). That was the optimum at
  # 11 GPa; the cell moved when it was squeezed to 30 GPa and the sample is no
  # longer there. Kept commented below.
  #
  # WARNING, read before trusting any gold-free column off this map:
  # the Au 111 marker sat at q = 2.7182 (a = 4.0037 A, ~11 GPa) as recently as
  # H0232 at 12:40 on 2026-09-13. At 30 GPa it is predicted at q ~ 2.782, which
  # lands in lambda2M's DEAD GAP between module 1 (ends 2.7808) and module 2
  # (starts 2.8020), and just below eiger4M's lower edge (2.7853). It only stays
  # inside module 1 up to ~28 GPa. If it has moved into the gap then NO detector
  # sees gold, every point looks gold-free, and that is indistinguishable in the
  # analysis from a genuinely clean sample. Use sample_2 + the gold_check
  # protocol to find out, or check the first reduced points of this map.
  sample_1:
    sample_name: HEA-Mesh30
    header: G
    inner_center: -0.2164
    outer_center: 21.3200
    inner_range: 0.1
    outer_range: 0.1
    inner_pts: 21
    outer_pts: 21

  # ------------------------------------------------------------------------
  # sample_2 -- the gold marker spot, as a 1 x 1
  # ------------------------------------------------------------------------
  # Where H0230/H0231/H0232 were taken at midday. At 11 GPa this point gave a
  # clean Au 111 at q = 2.7182, 7.6x above the module-1 background, so it is the
  # right place to ask "where has the marker gone" after a pressure change.
  # Pair it with the gold_check protocol in measurement_info.yaml (~1 min).
  #
  # Caveat: a null result here is ambiguous. It means EITHER the marker moved
  # out of the detector's q window OR the grain moved out of the beam when the
  # cell was squeezed. A peak appearing anywhere new is conclusive; its absence
  # is not.
  sample_2:
    sample_name: Gold-Chk
    header: H
    inner_center: -0.196
    outer_center: 21.275
    inner_range: 0
    outer_range: 0
    inner_pts: 1
    outer_pts: 1

