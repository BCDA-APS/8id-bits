defaults:
  inner_motor: huber.x
  outer_motor: huber.y
  inner_range: 0.005
  outer_range: 0.00
  inner_pts: 350
  outer_pts: 1

samples:

  # ------------------------------------------------------------------------
  # sample_1 -- ATTENUATION SERIES SPOT (2026-09-13 late), ONE fixed point
  # ------------------------------------------------------------------------
  # huber.x -0.1769, huber.y 21.3300 -- mesh point r00271 of the G0242 map.
  # Picked as the strongest eiger peak among points with NO line anywhere on
  # lambda2M:
  #
  #   eiger peak    q 2.9869 (2theta 22.359, d 2.1036 A), I 0.4912 over a
  #                 0.1300 base -> contrast 3.78.  a_fcc = 3.6435 A if 111
  #   lambda2M      narrow-feature score 0.034, the LOWEST of all 438 points
  #                 (gold-blob points run 2.5-4.5). Module 1 flat at max/med
  #                 1.10, so no Au 111.
  #
  # Runner-up r00292 (-0.1769, 21.3350) has slightly better contrast (3.98) but
  # a dirtier lambda (0.089 vs 0.034). 330 of 438 points are lambda-clean, so
  # there is no shortage of alternatives if this one misbehaves.
  #
  # 1 x 1 with both ranges 0: sample_mesh_move() has total_pts = 1 and always
  # resolves to point 0, so every attenuation step re-commands this exact
  # coordinate and they all sample the same illuminated volume.
  #
  # The 21 x 21 G0242 mesh block is kept commented below.
  sample_1:
    sample_name: HEA-Att30
    header: G
    inner_center: -0.1769
    outer_center: 21.3300
    inner_range: 0
    outer_range: 0
    inner_pts: 1
    outer_pts: 1

  # ------------------------------------------------------------------------
  # sample_2 -- MARKER CHECK SPOT (2026-09-13, 30 GPa)
  # ------------------------------------------------------------------------
  # huber.x -0.2169, huber.y 21.3200 -- the position the user found sample at
  # after the squeeze, and where Au 111 was seen live at 2theta 20.82.
  #
  # The question this answers is narrow: does the marker survive REDUCTION?
  # 2theta 20.82 = q 2.7837, which sits in a 0.04 deg blind spot between
  # lambda2M module 1's last binned q (2.7808 = 20.79 deg) and eiger4M's first
  # (2.7853 = 20.83 deg). Seeing it on a live image does not mean it lands in
  # scattering_1d, which is all the mesh analysis reads.
  #
  # Previous marker spot, used for H0230..H0232 at 11 GPa: (-0.196, 21.275).
  sample_2:
    sample_name: Gold-Chk
    header: H
    inner_center: -0.2169
    outer_center: 21.3200
    inner_range: 0
    outer_range: 0
    inner_pts: 1
    outer_pts: 1

  # The G0242 30 GPa mesh block (441 pts, 5 um, centre -0.2169 / 21.3200).
  #
  # sample_1:
  #   sample_name: HEA-Mesh30
  #   header: G
  #   inner_center: -0.2169
  #   outer_center: 21.3200
  #   inner_range: 0.1
  #   outer_range: 0.1
  #   inner_pts: 21
  #   outer_pts: 21

  # The attenuation-ladder spot as a 1 x 1 (G0223..G0229, 2026-09-13 overnight).
  # Restore as sample_1 to sit on that exact point again.
  #
  # sample_1:
  #   sample_name: HEA-Att
  #   header: G
  #   inner_center: -0.2010
  #   outer_center: 21.3250
  #   inner_range: 0
  #   outer_range: 0
  #   inner_pts: 1
  #   outer_pts: 1

  # The G0222 21 x 21 mesh block, as run on 2026-09-12 (441 points, 5 um step).
  #
  # sample_1:
  #   sample_name: HEA-Att
  #   header: G
  #   inner_center: -0.216
  #   outer_center: 21.32
  #   inner_range: 0.1
  #   outer_range: 0.1
  #   inner_pts: 21
  #   outer_pts: 21

  # The earlier G0202 mesh block.
  #
  # sample_1:
  #   sample_name: HEA-Mesh
  #   header: G
  #   inner_center: -0.213
  #   outer_center: 21.33
  #   inner_range: 0.1
  #   outer_range: 0.1
  #   inner_pts: 21
  #   outer_pts: 21

  # sample_3:
  #   sample_name: EmptyDAC
  #   header: C
  #   inner_center: -1.0
  #   outer_center: 40.85
  #   inner_range: 0.1
  #   outer_range: 0.1
  #   inner_pts: 3 
  #   outer_pts: 3

  # sample_4:
  #   sample_name: G10
  #   header: A
  #   inner_center: -1.65
  #   outer_center: 44.71
  #   inner_range: 0.5
  #   outer_range: 0.5
  #   inner_pts: 3 
  #   outer_pts: 3
